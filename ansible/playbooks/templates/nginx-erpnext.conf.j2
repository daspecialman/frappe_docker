map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    server_name {{ erpnext_domain }};
    client_max_body_size {{ client_max_body_size | default('100M') }};

    location / {
        proxy_pass http://127.0.0.1:{{ frappe_frontend_port | default('8080') }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout {{ proxy_read_timeout | default('3600s') }};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/{{ erpnext_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ erpnext_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name {{ erpnext_domain }};
    return 301 https://$host$request_uri;
}
